{
  "expo": {
    "name": "RSSReels",
    "slug": "RSSReels",
    "owner": "mossyisme",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rssreels",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mossyisme.rssreels",
      "adaptiveIcon": {
        "backgroundColor": "#EA7819",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E36F21",
          "image": "./assets/images/rss.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2a7c9b65-acd8-4585-9d5c-137675108586"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2a7c9b65-acd8-4585-9d5c-137675108586"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
